APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=example_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcast / WebSockets (real-time chat). Use "reverb" for Reverb, "pusher" for Pusher, "log" to disable.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=local
REVERB_APP_KEY=local
REVERB_APP_SECRET=local
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Frontend (Vite) – pass to Echo for WebSocket
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CORS Settings (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Payment Settings
PAYMENT_DEFAULT_CUSTOMER_EMAIL=noreply@nathefah.com

# ============================================================================
# Amazon Payment Services (APS / PayFort)
# ============================================================================
PAYMENT_GATEWAY=amazon_pay
AMAZON_PAYMENT_SERVICES_ENABLED=true

# Sandbox toggle (NOT hardcoded — resolved in config/payment.php + the gateway).
#   true  = SANDBOX  -> https://sbcheckout.payfort.com  + TEST_* credentials
#   false = PRODUCTION -> https://checkout.payfort.com   + live credentials
# Set this to true to run APS sandbox validation, then back to false for live.
AMAZON_PAYMENT_SERVICES_TEST_MODE=false

# Transaction command:
#   AUTHORIZATION = place a hold, then CAPTURE or VOID later (auth->capture/void flow)
#   PURCHASE      = authorize + capture in one step (no separate void of an auth)
# APS sandbox sign-off for Authorization + Capture + Void requires AUTHORIZATION.
AMAZON_PAYMENT_COMMAND=AUTHORIZATION
AMAZON_PAYMENT_LANGUAGE=ar
AMAZON_PAYMENT_CURRENCY=SAR

# Sandbox credentials (used only when AMAZON_PAYMENT_SERVICES_TEST_MODE=true)
AMAZON_PAYMENT_TEST_MERCHANT_ID=
AMAZON_PAYMENT_TEST_ACCESS_CODE=
# Wrap SHA phrases in single quotes — they often contain $, &, ), ? etc.
AMAZON_PAYMENT_TEST_SHA_REQUEST_PHRASE=''
AMAZON_PAYMENT_TEST_SHA_RESPONSE_PHRASE=''

# PayFort remember_me / token_name — enable only after APS enables it on your merchant account (error 00027 if off)
AMAZON_PAY_TOKENIZATION_ENABLED=false

# Enable /payment-test/* pages on server (without APP_DEBUG=true)
PAYMENT_TEST_PAGES=false

# Live credentials (used only when AMAZON_PAYMENT_SERVICES_TEST_MODE=false)
AMAZON_PAYMENT_MERCHANT_ID=
AMAZON_PAYMENT_ACCESS_CODE=
AMAZON_PAYMENT_SHA_REQUEST_PHRASE=''
AMAZON_PAYMENT_SHA_RESPONSE_PHRASE=''

# ============================================================================
# Moyasar (https://moyasar.com) — second payment gateway (switchable in admin)
# ============================================================================
# The ACTIVE gateway for real transactions is chosen in the admin panel
# (admin_settings 'active_payment_gateway'); PAYMENT_GATEWAY above is the default.
# Keep MOYASAR_ENABLED=true so the gateway stays registered and ready to activate.
MOYASAR_ENABLED=true

# Sandbox toggle: true = test keys (sk_test_/pk_test_), false = live keys.
# Default false (live) — same fail-to-live safety as APS.
MOYASAR_TEST_MODE=false

# Capture model:
#   PURCHASE      = charge immediately (default; universally supported)
#   AUTHORIZATION = hold then capture/void later — REQUIRES Moyasar manual capture
#                   enabled on your account (confirm with Moyasar before enabling)
MOYASAR_COMMAND=AUTHORIZATION
MOYASAR_CURRENCY=SAR
MOYASAR_LANGUAGE=ar
MOYASAR_API_BASE=https://api.moyasar.com/v1

# Test keys (used only when MOYASAR_TEST_MODE=true). Wrap in single quotes.
MOYASAR_TEST_SECRET_KEY=''
MOYASAR_TEST_PUBLISHABLE_KEY=''
MOYASAR_TEST_WEBHOOK_SECRET=''

# Live keys (used only when MOYASAR_TEST_MODE=false)
MOYASAR_SECRET_KEY=''
MOYASAR_PUBLISHABLE_KEY=''
MOYASAR_WEBHOOK_SECRET=''

# Firebase Settings
FIREBASE_PROJECT_ID=nathefah-146b3
FIREBASE_SERVICE_ACCOUNT_PATH=storage/app/firebase/nathefah-146b3-firebase-adminsdk-fbsvc-26b2bd2f10.json
# Legacy — not used when service account is configured
FIREBASE_SERVER_KEY=

# ============================================================================
# Invoice / ZATCA / WhatsApp
# ============================================================================
INVOICE_AUTO_ISSUE=true
INVOICE_ISSUE_COD=false
INVOICE_PUBLIC_LINK_TTL_DAYS=30
INVOICE_CURRENCY=SAR

INVOICE_COMPANY_NAME_AR='نظيفة'
INVOICE_COMPANY_NAME_EN='Nathefah'
INVOICE_COMPANY_VAT_NUMBER=
INVOICE_COMPANY_REGISTRATION_NUMBER=
INVOICE_COMPANY_ADDRESS=

# ZATCA provider adapter
INVOICE_ZATCA_ENABLED=false
INVOICE_ZATCA_DRIVER=http
INVOICE_ZATCA_ENVIRONMENT=sandbox
INVOICE_ZATCA_BASE_URL=
INVOICE_ZATCA_SUBMIT_PATH=/invoices
INVOICE_ZATCA_API_KEY=
INVOICE_ZATCA_TIMEOUT=20

# WhatsApp provider adapter
INVOICE_WHATSAPP_ENABLED=false
INVOICE_WHATSAPP_DRIVER=http
INVOICE_WHATSAPP_BASE_URL=
INVOICE_WHATSAPP_SEND_PATH=/messages
INVOICE_WHATSAPP_API_KEY=
INVOICE_WHATSAPP_TEMPLATE=invoice_link
INVOICE_WHATSAPP_SENDER=
INVOICE_WHATSAPP_TIMEOUT=20
